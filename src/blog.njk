---
title: Blog
layout: base.njk
---

<section class="blog-premium">
    <div class="blog-premium-header">
        <h1 class="section-title-premium">Recent Articles</h1>
        <p class="section-subtitle-premium">Discover my latest writing, thoughts, and reflections.</p>
    </div>
    
    <div class="blog-premium-grid">
        {%- for post in collections.post | reverse -%}
        <article class="premium-card">
            <a href="{{ post.url }}" class="premium-card-link">
                <div class="premium-card-image">
                    <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt }}" loading="lazy">
                </div>
                <div class="premium-card-content">
                    <time class="premium-card-date">{{ post.date | postDate }}</time>
                    <h3 class="premium-card-title">{{ post.data.title }}</h3>
                    <p class="premium-card-description">{{ post.data.description }}</p>
                    <span class="premium-card-readmore">
                        Continue Reading 
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </span>
                </div>
            </a>
        </article>
        {%- endfor -%}
    </div>
</section>
